{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:create_app", "--factory", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "frontend-dev-3001",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/scripts/next.mjs", "dev", "frontend", "--hostname", "127.0.0.1", "--port", "3001"],
      "port": 3001
    }
  ]
}
